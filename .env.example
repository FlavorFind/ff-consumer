# ff-consumer — environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# Django
SECRET_KEY=change-me-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database
DATABASE_URL=postgres://ff_consumer:ff_consumer_pass@localhost:5432/ff_consumer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ff_consumer
DB_USER=ff_consumer
DB_PASSWORD=ff_consumer_pass

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Engine (never put real keys here — use secret manager in production)
ENGINE_BASE_URL=https://engine.flavorfind.co.ke
ENGINE_API_KEY=
ENGINE_INTERNAL_KEY=

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001

# Paystack (https://dashboard.paystack.com/#/settings/developer)
# Use test keys for dev/staging, live keys for production
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://flavorfind.co.ke/plus/success

SENTRY_DSN=

# App version (set by CI/CD)
CONSUMER_VERSION=dev
